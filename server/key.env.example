# Copy this file to server/key.env and fill it in. Never commit key.env.

# ---- Existing chatbot (optional) ----
OPENAI_API_KEY=
PORT=3001

# ---- Where things live ----
# Your tunnel to port 3001 (cloudflared tunnel --url http://localhost:3001  OR  ngrok http 3001)
PUBLIC_BASE_URL=
# Where the website runs (used in the text recap link)
APP_URL=http://localhost:5173
# Any random string; the voice agent sends it so strangers can't call your tool endpoints
TOOL_SECRET=corolla-ary-4cac83e29f80f8d0

# ---- Claude (texting brain) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- ElevenLabs (voice: ears, mouth, phone line; Claude is still the brain) ----
ELEVENLABS_API_KEY=
# Filled in by: npx tsx scripts/setup-voice-agent.ts
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Optional overrides
# ELEVENLABS_LLM=
# ELEVENLABS_VOICE_ID=

# ---- Photon 2.0 (phone number, texting, SIP) ----
PHOTON_PROJECT_ID=pho_prj_01m6vy374geh7sd0wb5jp516xb
PHOTON_API_KEY=
# Your Photon SMS & Voice number in +1XXXXXXXXXX format
PHOTON_NUMBER=
PHOTON_PLATFORM=sms
# SIP login from Photon → Voice → SIP (used once by npm run setup:voice)
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
